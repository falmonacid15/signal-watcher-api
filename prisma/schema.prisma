generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Watchlist {
  id    String   @id @default(cuid())
  name  String
  terms String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]
}

model Event {
  id          String   @id @default(cuid())
  description String
  severity    Severity
  action      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id])
}

enum Severity {
  LOW
  MED
  HIGH
  CRITICAL
}
